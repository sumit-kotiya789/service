NODE_ENV=development
PORT=3000
WEBHOOK_PORT=3001

# Host port for docker-compose postgres. Change (and DATABASE_URL) if 5432 is taken locally.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://user:pass@localhost:5432/connecthub
REDIS_URL=redis://localhost:6379

# Must be >=32 chars; app refuses to start otherwise. Generate: openssl rand -hex 32
JWT_SECRET=change_me

# WhatsApp. VERIFY_TOKEN + APP_SECRET required from Phase 1 (signature check always on;
# use random test values locally). ACCESS_TOKEN + PHONE_NUMBER_ID needed from Phase 2.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# LLM (Phase 6+)
ANTHROPIC_API_KEY=

# Voice (Phase 7, optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
